[Unit]
Description=Chain of Custody banking sidecar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=coc
WorkingDirectory=/opt/banking-security-demo/defense
EnvironmentFile=/etc/chain-of-custody/sidecar.env
ExecStart=/opt/banking-security-demo/defense/.venv/bin/python -m sidecar.main --config /opt/banking-security-demo/defense/config.toml
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/srv/chain-of-custody/spool
ReadWritePaths=/opt/banking-security-demo/defense/data

[Install]
WantedBy=multi-user.target
