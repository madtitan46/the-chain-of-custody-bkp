[Unit]
Description=Banking Chain of Custody audit spooler
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=coc
WorkingDirectory=/opt/banking/backend
EnvironmentFile=/etc/chain-of-custody/banking.env
ExecStart=/usr/bin/npm run coc:spool
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/chain-of-custody/spool

[Install]
WantedBy=multi-user.target
